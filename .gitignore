# Python virtual environments — the gateway's own and the MCP server's
# separate one under mcp-servers/mini-razorpay-mcp/ (a bare pattern matches
# at any depth).
.venv/
venv/
env/
ENV/

# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables — real credentials (OpenAI/Gemini keys, Twilio/Meta
# tokens, database URL, Postgres connection strings), never commit. Template
# files are explicitly un-ignored below — they hold no real secrets and must
# stay tracked as the setup reference (see gateway/.env.example).
.env
.env.*
!.env.example

# Other secrets/credentials — anything that looks like a private key,
# certificate, or credentials dump, wherever it lives in the repo.
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secrets*.json
*.secret

# Alembic-generated bytecode lives under __pycache__ already; nothing
# additional needed there. Migration scripts themselves
# (gateway/alembic/versions/*.py) are real source code and stay tracked.

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Local database files — this project connects to Postgres via DATABASE_URL,
# never a committed local file; ignore any that show up from ad hoc local
# testing so one never gets committed by accident.
*.sqlite3
*.sqlite
*.db

# Logs
*.log
logs/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Node — not currently used anywhere in this project, kept defensively in
# case a frontend/tooling package is added later.
node_modules/
