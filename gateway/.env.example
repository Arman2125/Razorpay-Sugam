# Mini-Razorpay API — must be the API origin ending in /api, never a bare
# host:port or the frontend's URL.
MINI_RAZORPAY_BASE_URL=http://localhost:5000/api

# Razorpay Sugam's own database — a separate database from any other project
# on this Postgres instance, never shared.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/razorpay_sugam
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/razorpay_sugam

# OpenAI GPT — the sole reasoning / intent-understanding / tool-selection
# model (native tool-calling against the MCP tool schema). Required for the
# assistant to do anything beyond the identity/registration check.
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini — audio/video understanding ONLY (WhatsApp voice notes and video
# messages are transcribed/described by Gemini into plain text, which then
# goes through the exact same OpenAI reasoning pipeline as typed text).
# Gemini never does intent understanding or tool selection. Optional: if
# unset, voice/video messages get a graceful "couldn't process that" reply
# instead of a transcript, but text messages are unaffected.
GEMINI_API_KEY=
GEMINI_MODEL=

# Narrow, constrained LLM fallback used only when a tool result's error shape
# is genuinely unrecognized (never invents a cause it wasn't given). Off by
# default like every optional capability here — a malformed value is always
# treated as "false", never a startup crash.
LLM_FALLBACK_ENABLED_RAW=false

# WhatsApp Cloud API — the webhook routes mount regardless, but outbound
# sends short-circuit (logged, not attempted) until this is explicitly
# enabled AND real Meta credentials are set below.
WHATSAPP_ENABLED_RAW=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# /test/message exercises the full pipeline (real LLM call, real MCP/
# Mini-Razorpay tool calls) over plain HTTP with no authentication of its
# own — safe for local development, but must stay disabled in production
# unless explicitly turned on. Same fail-closed convention as every other
# optional flag here: unset/malformed is always treated as "false".
ENABLE_TEST_ENDPOINT_RAW=false

# MCP_SERVER_PATH / MCP_SERVER_PYTHON_PATH: omitted entirely (not set to
# empty) so config.py's computed default applies — MCP_SERVER_PATH resolves to
# mcp-servers/mini-razorpay-mcp/server.py relative to this gateway, and
# MCP_SERVER_PYTHON_PATH defaults to sys.executable (the same Python
# interpreter running the Gateway itself, not a separate venv) — this is what
# makes the MCP subprocess launch correctly on Linux/Render as well as
# Windows. Set explicitly here only to override that default.
MCP_CALL_TIMEOUT_SECONDS=45

# How often to poll Mini-Razorpay for payments a reminder auto-notified a
# customer about, to detect when they've paid and confirm it back to the
# merchant on WhatsApp — see app/services/payment_recovery_notifier.py.
PAYMENT_RECOVERY_POLL_INTERVAL_SECONDS=20

MERCHANT_DIRECTORY_SYNC_INTERVAL_SECONDS=300
JWT_CACHE_SAFETY_MARGIN_SECONDS=300
CONVERSATION_STATE_TTL_SECONDS=600
CONVERSATION_STATE_MAX_ATTEMPTS=3

# Generic multi-turn conversation memory — the actual conversation transcript
# per WhatsApp number, replayed to the LLM on every message so it can reason
# over prior turns instead of seeing each message in isolation. See
# app/services/conversation_history_service.py.
CONVERSATION_HISTORY_TTL_SECONDS=1800
CONVERSATION_HISTORY_MAX_TURNS=20
CONVERSATION_HISTORY_MAX_TOOL_RESULT_CHARS=2000

LOG_LEVEL=INFO
PYTHON_ENV=development
